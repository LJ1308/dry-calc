{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Open in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173/dry-calc/",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
